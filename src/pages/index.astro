---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const [latestPost] = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<section class="intro">
				<p class="eyebrow">Bran Yang</p>
				<h1>Building, learning, and thinking in public.</h1>
				<p class="lede">
					I use mathematics, software, and AI to solve practical problems. Now I am documenting the
					move from advising businesses to building them.
				</p>
				<div class="actions">
					<a class="primary" href="/blog/a-place-to-think-in-public/">Read the launch post</a>
					<a href="/about">More about me</a>
				</div>
			</section>

			{
				latestPost && (
					<section class="latest" aria-labelledby="latest-heading">
						<p class="eyebrow" id="latest-heading">Latest note</p>
						<a href={`/blog/${latestPost.id}/`}>
							<h2>{latestPost.data.title}</h2>
							<p>{latestPost.data.description}</p>
							<FormattedDate date={latestPost.data.pubDate} />
						</a>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding-block: 5rem;
	}
	.intro {
		padding-bottom: 4rem;
	}
	.eyebrow {
		margin: 0 0 0.75rem;
		color: var(--accent-dark);
		font-size: 0.8rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}
	h1 {
		max-width: 12ch;
		margin-bottom: 1.5rem;
	}
	.lede {
		max-width: 38rem;
		font-size: 1.25rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.5rem;
		margin-top: 2rem;
	}
	.actions a {
		font-weight: 700;
	}
	.actions .primary {
		padding: 0.65rem 1rem;
		border-radius: 0.4rem;
		background: var(--accent);
		color: white;
		text-decoration: none;
	}
	.latest {
		padding-top: 2.5rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.latest > a {
		display: block;
		color: inherit;
		text-decoration: none;
	}
	.latest h2 {
		margin-bottom: 0.75rem;
		font-size: 2rem;
	}
	.latest p:not(.eyebrow) {
		margin: 0 0 0.5rem;
	}
	.latest time {
		color: rgb(var(--gray));
		font-size: 0.9rem;
	}
	.latest > a:hover h2 {
		color: var(--accent);
	}
	@media (max-width: 720px) {
		main {
			padding-block: 3rem;
		}
		h1 {
			font-size: 2.5rem;
		}
	}
</style>
